<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="accountVM"
            type="com.daywei.mediavideotest.ui.personal.PersonalVM" />
    </data>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_personal_head"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="20dp"
                android:background="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/iv_personal_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:ellipsize="end"
                android:text="@{accountVM.account.userName}"
                android:textSize="56sp"
                app:layout_constraintBaseline_toTopOf="@id/iv_personal_head"
                app:layout_constraintStart_toEndOf="@id/iv_personal_head" />

            <TextView
                android:id="@+id/tv_personal_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{Integer.toString(accountVM.account.userId)}"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@id/tv_personal_ip"
                app:layout_constraintStart_toStartOf="@id/iv_personal_name"
                app:layout_constraintTop_toBottomOf="@id/iv_personal_name" />

            <TextView
                android:id="@+id/tv_personal_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{accountVM.account.ipAddress}"
                android:textSize="28sp"
                app:layout_constraintBaseline_toBottomOf="@id/iv_personal_head"
                app:layout_constraintStart_toStartOf="@id/iv_personal_name" />

            <TextView
                android:id="@+id/tv_personal_signature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="86dp"
                android:text="@{accountVM.account.signature}"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/iv_personal_head" />

            <TextView
                android:id="@+id/tv_content_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:text="@{Integer.toString(accountVM.account.identify)}"
                android:textSize="28sp"
                app:layout_constraintTop_toBottomOf="@id/tv_personal_signature" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_personal_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_content_tag" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</layout>